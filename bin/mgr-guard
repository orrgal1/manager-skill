#!/usr/bin/env bash
# mgr-guard — the 429 watcher, burn projection and backlog collector behind mgr-managed
# omp builders. Three jobs, nothing else: re-prompt every manager and builder pane that
# stopped on a provider rate limit once the quota renews; keep a per-limit burn projection
# that `mgr board` surfaces; and collect every registered manager's backlog and measured
# throughput each tick so `mgr-guard overview` can project the machine-wide timeline.
# Each tick polls the union of live managers' registered providers and stalled panes'
# providers — never a single machine-wide default — so a mixed-house fleet samples every
# subscription it actually runs on. `builder_provider()` (the machine's omp default) only
# fills in when that union is empty.
# It never dials pace: concurrency is the operator's `cap` and `mgr` alone enforces it.
# No agent, no LLM: pure bash + jq.
# Deps: jq (hard), omp + herdr (soft: their failures degrade a single entry).
# All stdout is JSON; errors are JSON on stderr.
set -euo pipefail

# ---------------------------------------------------------------- primitives

die() { # die <exit-code> <message>
  local code="$1"; shift
  jq -nc --argjson c "$code" --arg m "$*" '{error:{code:$c,message:$m}}' >&2
  exit "$code"
}
warn() { printf 'mgr-guard: warning: %s\n' "$*" >&2; }

command -v jq >/dev/null 2>&1 || { printf 'mgr-guard: missing dependency: jq\n' >&2; exit 1; }

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# RATE_RE and session_metrics live in the sourced lib; mgr reaches it the
# same way, so both scripts stay in sync on what counts as a rate-limit stall.
MGR_LIB="$(dirname "$SELF")/mgr-lib.sh"
[ -f "$MGR_LIB" ] || die 1 "mgr-lib.sh not found at $MGR_LIB"
# shellcheck source=bin/mgr-lib.sh
. "$MGR_LIB"

STATE_DIR="${MGR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/mgr-guard}"
PIDFILE="$STATE_DIR/guard.pid"
LOGFILE="$STATE_DIR/guard.log"
STATEFILE="$STATE_DIR/state.json"
MGRDIR="$STATE_DIR/managers"
SAMPLES="$STATE_DIR/samples.jsonl"
LOCKDIR="$STATE_DIR/guard.lock"
EXITFILE="$STATE_DIR/exit.json"
LAUNCHDIR="$STATE_DIR/launches"
THRUDIR="$STATE_DIR/throughput"
BACKLOGDIR="$STATE_DIR/backlog"

INTERVAL_S="${MGR_GUARD_INTERVAL:-60}"
SLOPE_WINDOW_S="${MGR_GUARD_SLOPE_WINDOW_S:-1800}"
MIN_SLOPE_SPAN_S="${MGR_GUARD_MIN_SLOPE_SPAN_S:-300}"
IDLE_EXIT_S="${MGR_GUARD_IDLE_EXIT_S:-1800}"
NOTIFY="${MGR_GUARD_NOTIFY:-1}"
BACKLOG_INTERVAL_S="${MGR_GUARD_BACKLOG_INTERVAL_S:-120}"
DEFAULT_TASK_S="${MGR_DEFAULT_TASK_S:-2700}"

int_or() { # int_or <value> <fallback>
  case "${1:-}" in
    ''|*[!0-9]*) printf '%s' "$2";;
    *) if [ "$1" -gt 0 ]; then printf '%s' "$1"; else printf '%s' "$2"; fi;;
  esac
}
INTERVAL_S=$(int_or "$INTERVAL_S" 60)
SLOPE_WINDOW_S=$(int_or "$SLOPE_WINDOW_S" 1800)
MIN_SLOPE_SPAN_S=$(int_or "$MIN_SLOPE_SPAN_S" 300)
BACKLOG_INTERVAL_S=$(int_or "$BACKLOG_INTERVAL_S" 120)
DEFAULT_TASK_S=$(int_or "$DEFAULT_TASK_S" 2700)
case "${IDLE_EXIT_S:-}" in ''|*[!0-9]*) IDLE_EXIT_S=1800;; esac

ensure_state_dir() { mkdir -p "$MGRDIR" 2>/dev/null || die 1 "cannot create state dir: $STATE_DIR"; }

now_ms() { # tests pin the clock with MGR_GUARD_NOW_MS
  if [ -n "${MGR_GUARD_NOW_MS:-}" ]; then printf '%s' "$MGR_GUARD_NOW_MS"; return; fi
  printf '%s000' "$(date +%s)"
}

iso_of() { # iso_of <ms>
  local s=$(( ${1:-0} / 1000 ))
  # GNU date renders an epoch with -d @N; BSD/macOS date uses -r N (GNU -r is a file's mtime)
  if date --version >/dev/null 2>&1; then
    date -u -d "@$s" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf 'unknown'
  else
    date -u -r "$s" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf 'unknown'
  fi
}

mtime_of() { # mtime_of <path> -> epoch seconds, 0 when unknown
  # GNU stat spells mtime -c %Y; BSD/macOS stat spells it -f %m
  if stat --version >/dev/null 2>&1; then
    stat -c %Y "$1" 2>/dev/null || printf '0'
  else
    stat -f %m "$1" 2>/dev/null || printf '0'
  fi
}

log() { # log <level> <msg...>
  local lvl="$1"; shift
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  printf '%s %s %s\n' "$(iso_of "$(now_ms)")" "$lvl" "$*" >>"$LOGFILE" 2>/dev/null || true
}

atomic_write() { # atomic_write <dest>   (content on stdin)
  local dest="$1" tmp
  tmp="$(dirname "$dest")/.tmp.$$.${RANDOM}"
  if cat >"$tmp"; then mv -f "$tmp" "$dest"; else rm -f "$tmp"; return 1; fi
}

pidfile_pid() {
  [ -f "$PIDFILE" ] || return 0
  tr -dc '0-9' <"$PIDFILE" 2>/dev/null || true
}

live_pid() { # prints the pid when the recorded process is alive
  local p; p=$(pidfile_pid)
  if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then printf '%s' "$p"; fi
}

# Every daemon exit leaves a note behind: a guard that is gone shows up on the board with a
# reason instead of a bare `guard: stopped` nobody can explain.
record_exit() { # record_exit <reason>
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0
  jq -nc --argjson at "$(now_ms)" --arg r "$1" '{at:$at, reason:$r}' \
    | atomic_write "$EXITFILE" || warn "cannot write $EXITFILE"
}

read_exit() { # read_exit -> {at,reason}, nulls when the file is absent or junk
  local ex=""
  if [ -f "$EXITFILE" ]; then
    ex=$(jq -c 'if type == "object"
                then {at: (if (.at | type) == "number" then .at else null end),
                      reason: (if (.reason | type) == "string" then .reason else null end)}
                else {at:null, reason:null} end' "$EXITFILE" 2>/dev/null) || ex=""
  fi
  case "$ex" in ''|null) ex='{"at":null,"reason":null}';; esac
  printf '%s' "$ex"
}

# ---------------------------------------------------------------- jq programs

# raw session lines on stdin -> {provider,model,stall}
JQ_SESSION_FACTS='
def ts_ms($s):
  (($s // "") | sub("\\.[0-9]+Z$"; "Z"))
  | if . == "" then null else ((fromdateiso8601 * 1000)? // null) end;
[ inputs | (fromjson? // empty) | select(type == "object")
  | select((.type == "message") and ((.message | type) == "object") and (.message.role == "assistant")) ]
| (last // null) as $m
| if $m == null then {provider: null, model: null, stall: null}
  else ($m.message.errorMessage // "") as $em
  | {provider: ($m.message.provider // null), model: ($m.message.model // null)}
    + {stall:
        (if ($m.message.stopReason == "error")
            and (($m.message.errorStatus == 429) or ($em | test($re; "i")))
         then {provider: ($m.message.provider // null),
               model: ($m.message.model // null),
               error: ($em | .[0:300]),
               since: ((ts_ms($m.timestamp)) // $now),
               retry_after_ms: ((($em | capture("retry-after-ms=(?<n>[0-9]+)") | .n | tonumber)?) // null)}
         else null end)}
  end'

# the whole policy: liveness, the burn projection, the 429 ledger and reignite candidates
JQ_POLICY='
def hrs($ms): $ms / 3600000;
def r2: (. * 100 | round) / 100;
def pct: (. * 100 | round);
def iso($ms): if $ms == null then "unknown" else (($ms / 1000) | floor | todate) end;
def hhmm($ms): if $ms == null then "unknown"
               else ((($ms / 1000) | floor | todate)[11:16] + "Z") end;
def slope($s):
  ($s | length) as $n
  | if $n < 2 then 0
    else ((($s | last).t) - (($s | first).t)) as $span
    | if $span < ($min_span * 1000) then 0
      else ([$s[] | hrs(.t)]) as $xs | ([$s[] | .used]) as $ys
        | (($xs | add) / $n) as $mx | (($ys | add) / $n) as $my
        | ([range(0; $n) | ($xs[.] - $mx) * ($ys[.] - $my)] | add) as $sxy
        | ([$xs[] | (. - $mx) * (. - $mx)] | add) as $sxx
        | if $sxx == 0 then 0
          else (($sxy / $sxx) as $b | if $b < 0 then 0 else $b end) end
      end
    end;

# a sample belongs to a limit window when both reset stamps sit inside the same
# 2-minute bucket: `omp usage` jitters resets_at by milliseconds between calls
def same_window($a; $b):
  if ($a == null) and ($b == null) then true
  elif ($a == null) or ($b == null) then false
  else ((($a - $b) | fabs) <= 120000) end;

# ---- managers: live vs dead registrations.
# Liveness is the herdr pane, never the heartbeat: a manager stalled on a 429 stops running
# `mgr board`, so heartbeat recency goes dark exactly when the guard is needed. seen_at stays
# on the registration as information only.
($managers | map((((.pane_id // "") | IN($panes[]))) as $pa
                 | . + {pane_alive: $pa, live: $pa}
                 # this tick collected the board snapshot and the throughput stats
                 | . + (($extras[(.manager_id // "")])
                        // {backlog: null, backlog_at: null, backlog_error: null,
                            throughput: null}))) as $mgrs
| ($mgrs | map(select(.live))) as $live
| ($mgrs | map(select(.live | not))) as $dead
| ($live | map({key: (.workspace_id // ""), value: .manager_id}) | from_entries) as $ws2mgr

# ---- the projection: one least-squares fit per limit window, then a verdict per provider.
# Data only — nothing downstream of this throttles anything.
| ($reports | map(
    . as $r
    | (($r.limits // []) | map(
        . as $l
        | ([ $samples[] | select((.provider == $r.provider) and (.limit == $l.id)
              and (same_window(.resets_at; $l.resets_at))
              and (.t >= ($now - ($slope_window * 1000)))) ]
           | sort_by(.t) | map({t: .t, used: (.used // 0)})) as $s
        | slope($s) as $bph
        | (if ($l.resets_at // null) == null then 0 else hrs([0, ($l.resets_at - $now)] | max) end) as $htr
        | (($l.used // 0) + ($bph * $htr)) as $proj
        | {id: $l.id, label: ($l.label // $l.id), status: ($l.status // "unknown"),
           used: (($l.used // 0) | r2), resets_at: ($l.resets_at // null),
           burn_per_hour: ($bph | r2), projected_at_reset: ($proj | r2), fits: ($proj <= 1),
           hours_to_reset: ($htr | r2), sample_count: ($s | length), samples: $s}
      )) as $limits
    | ([$limits[] | select((.status == "exhausted") or (.used >= 1))] | sort_by(.resets_at // 0)) as $ex
    | (if ($limits | length) == 0 then "unknown"
       elif ($ex | length) > 0 then "exhausted"
       elif ($limits | any(.status == "warning")) then "warning"
       else "ok" end) as $fresh
    | (([$limits[] | select(.fits | not)] | max_by(.projected_at_reset))) as $worst
    | (if ($limits | length) == 0 then "unknown: no reading"
       elif $worst == null then "fits"
       else ($worst.id + " at " + (($worst.used | pct) | tostring) + "% burning "
             + ($worst.burn_per_hour | tostring) + "/h → "
             + ($worst.projected_at_reset | tostring) + "× the window by "
             + hhmm($worst.resets_at)) end) as $fitted
    # a failed fetch holds the last verdict: an exhausted window that has not reset yet is
    # still exhausted, whatever `omp usage` can or cannot tell us this tick
    | (($r.prev_recovers_at // null)) as $hold
    | (if $r.ok then
         # a window sitting at 100% with no burn "fits" by the arithmetic; say what it is instead
         {status: $fresh,
          reason: (if ($ex | length) > 0
                   then (($ex | first).id + " exhausted, resets at " + hhmm(($ex | first).resets_at // null))
                   else $fitted end),
          recovers_at: (if ($ex | length) > 0 then (($ex | first).resets_at // null) else null end),
          exhausted_limit: (if ($ex | length) > 0 then ($ex | first).id else null end)}
       elif ($hold != null) and ($now < $hold) then
         {status: "exhausted", recovers_at: $hold, exhausted_limit: ($r.prev_exhausted_limit // null),
          reason: ("unknown: holding last verdict (exhausted until " + iso($hold) + ")")}
       else {status: "unknown", recovers_at: null, exhausted_limit: null, reason: "unknown: no reading"} end) as $v
    | {key: $r.provider,
       value: {status: $v.status, ok: ($r.ok // false), fetched_at: ($r.fetched_at // null),
               usage_fetch_failures: (if $r.ok then 0 else (($r.prev_failures // 0) + 1) end),
               recovers_at: $v.recovers_at, exhausted_limit: $v.exhausted_limit,
               reason: $v.reason, limits: $limits}}
  ) | from_entries) as $polled

# ---- a provider nobody polled this tick keeps its hold. The poll set follows live panes, so a
# manager pane missing from one `herdr agent list` must not make the guard forget an exhausted
# window it is still waiting out: a builder that 429s on it during a usage outage would otherwise
# have no recovers_at and miss its reset. Only the verdict travels, never the numbers: limits is
# empty, so the board says no reading, and the entry drops the moment the reset has passed.
| ((($prev.providers // {}) | with_entries(
      select(((.key | IN($polled | keys[])) | not)
             and ((.value.recovers_at // null) != null) and ($now < .value.recovers_at))
      | .value |= {status: "exhausted", ok: false, fetched_at: (.fetched_at // null),
                   usage_fetch_failures: (.usage_fetch_failures // 0),
                   recovers_at, exhausted_limit: (.exhausted_limit // null),
                   reason: ("unknown: not polled this tick, holding last verdict (exhausted until "
                            + iso(.recovers_at) + ")"),
                   limits: []}))
   + $polled) as $providers

# ---- the 429 ledger, upserted against the previous tick. Nothing else lands here: a builder
# is only ever in this list because its own turn died on a provider rate limit.
| ([ $agents[] | select((.stall != null) and (.agent_status != "working")) ] | map(
    . as $a | $a.stall as $s
    | (($s.retry_after_ms // 60000)) as $ra
    | ($s.since + ([$ra, 900000] | min)) as $first
    | ((($prev.stalled // []) | map(select(.pane_id == $a.pane_id)) | first) // null) as $p
    | (($providers[($s.provider // "")] // null)) as $pv
    # manager_id is the live registration of that workspace: a stalled builder keeps its
    # manager attribution across the stall, which is what the board reads
    | {pane_id: $a.pane_id, name: $a.name, workspace_id: $a.workspace_id, session: $a.session,
       provider: $s.provider, model: $s.model, error: $s.error, since: $s.since,
       retry_after_ms: $s.retry_after_ms,
       recovers_at: (((($pv | if . == null then null else .recovers_at end))
                      // (if $p == null then null else ($p.recovers_at // null) end))),
       limit: (((($pv | if . == null then null else .exhausted_limit end))
                // (if $p == null then null else ($p.limit // null) end))),
       manager_id: ($ws2mgr[($a.workspace_id // "")] // null)}
      + (if ($p != null) and ($p.since == $s.since)
         then {attempts: ($p.attempts // 0), last_reignite_at: ($p.last_reignite_at // null),
               next_reignite_at: ($p.next_reignite_at // $first)}
         else {attempts: 0, last_reignite_at: null, next_reignite_at: $first} end)
  )) as $stalled

# ---- reignite candidates: the quota is back when a fresh reading says so, or when the reset
# ---- we were waiting for has passed. An unknown provider is never good enough on its own.
| ([ $stalled[] | . as $st
     | select($now >= ($st.next_reignite_at // 0))
     | (($providers[($st.provider // "")] // null)) as $pv
     | ((($pv | if . == null then null else .status end)) // "unknown") as $pstat
     | ((($pv | if . == null then false else (.ok // false) end))) as $pok
     | (($pok and ($pstat | IN("ok", "warning")))) as $positive
     | ((($st.recovers_at // null) != null) and ($now >= $st.recovers_at)) as $reset_passed
     | select($positive or $reset_passed)
     | (($pv | if . == null then [] else (.limits // []) end)) as $ls
     # the prompt names the limit whose reset we were waiting for when it is known,
     # otherwise the fullest one — the 429 came from the window closest to full
     | ((($ls | map(select(.id == ($st.limit // ""))) | first) // ($ls | max_by(.used)))) as $l
     | (($l | if . == null then ($st.limit // "quota") else .id end)) as $lid
     | (($st.recovers_at // ($l | if . == null then null else (.resets_at // null) end))) as $rat
     | {pane_id: $st.pane_id, provider: ($st.provider // "unknown"), limit: $lid,
        text: ((if $positive
                then ("mgr-guard: " + $lid + " reset at " + iso($rat) + ", now at "
                      + (((($l | if . == null then 0 else (.used // 0) end)) | pct) | tostring)
                      + "%.")
                else ("mgr-guard: " + $lid + " reset at " + iso($rat)
                      + " has passed (no fresh usage reading).") end)
               + " Your previous turn stopped on a provider rate limit (429)."
               + " Nobody needs to answer anything — resume exactly where you stopped"
               + " and continue under your existing instructions.")} ]) as $reignite

# ---- events for this tick (the reignite lines are appended after the prompts have run)
| ([ ($dead[] | {at: $now, kind: "manager_dropped",
                 detail: (.manager_id + ": pane " + (.pane_id // "?") + " is gone")}),
     ($providers | to_entries[] | . as $e
       | ((($prev.providers // {})[$e.key] // null) | if . == null then null else .status end) as $ps
       | if ($e.value.status == "exhausted") and ($ps != "exhausted")
         then {at: $now, kind: "exhausted",
               detail: ($e.key + ": exhausted until " + iso($e.value.recovers_at))}
         elif ($ps == "exhausted") and ($e.value.status | IN("ok", "warning"))
         then {at: $now, kind: "recovered", detail: ($e.key + ": " + $e.value.reason)}
         else empty end) ]) as $events

| {now: $now, builder_provider: $bp, providers: $providers,
   managers: $live, dead: ($dead | map(.manager_id)),
   stalled: $stalled, events: $events, reignite: $reignite}'

# policy output + prompt results -> {state, toasts, log}
JQ_FINALIZE='
def backoff($n): ([(900000 * pow(2; $n - 1)), 7200000] | min | floor);
($policy.now) as $now
# ---- reignition bookkeeping: a pane that was prompted waits out 15 min * 2^(n-1), capped at 2 h,
# whether the prompt landed or not — a herdr that cannot talk to the pane is not a free retry.
| ($policy.stalled | map(
    . as $s
    | (($results | map(select(.pane_id == $s.pane_id)) | first) // null) as $r
    | if $r == null then $s
      elif $r.ok then (($s.attempts // 0) + 1) as $n
        | $s + {attempts: $n, last_reignite_at: $now, next_reignite_at: ($now + backoff($n))}
      else (($s.attempts // 0) + 1) as $n
        | $s + {next_reignite_at: ($now + backoff($n))}
      end)) as $stalled
| ([ $results[] | select(.ok) | {at: $now, kind: "reignite",
      detail: (.pane_id + " (" + .provider + ", " + .limit + ")")} ]) as $rev
| (($policy.events) + $rev) as $new
| {state: {version: 2, pid: $pid, tick_at: $now, interval_s: $interval,
           builder_provider: $policy.builder_provider,
           providers: $policy.providers,
           managers: ($policy.managers | map({key: .manager_id, value: .}) | from_entries),
           stalled: $stalled,
           events: ((($prev.events // []) + $new) | .[-50:])},
   toasts: [ $new[] | select(.kind == "reignite") | (.kind + ": " + .detail) ],
   log: (($policy.providers | keys) as $ps
         | ($ps | join(",")) as $csv
         | ($ps | map(. as $p | $p + ":" + (($policy.providers[$p].status) // "unknown")) | join(",")) as $status
         | ($ps | map(. as $p | $p + ":" + (($policy.providers[$p].reason) // "n/a")) | join("; ")) as $reason
         | "tick providers=" + $csv
           + " status=" + $status
           + " managers=" + (($policy.managers | length) | tostring)
           + " stalled=" + (($stalled | length) | tostring)
           + " reignited=" + (($rev | length) | tostring)
           + " reason=" + $reason)}'

# open issues of one repo -> the backlog snapshot state.json carries for that manager.
# The ready/blocked/in_flight/awaiting/awaiting_plan rules mirror `mgr board` (bin/mgr JQ_BLOCKERS plus
# cmd_board): a `Blocked by:` reference counts only when it names an issue that is still
# open in this list. Only the scan spelling differs — jaq's `scan` stops at the first hit,
# so the blocker numbers come out of `match(...; "g")` here.
# An in-flight issue also carries what its builder runs on: `launch_model` off the same
# launch stamp `launched_at` comes from, and `model` off the builder pane's own session
# ($models, keyed by issue number) — the reading is as fresh as this refresh, exactly like
# launched_at. `overview` turns the pair into `model_changed`.
JQ_BACKLOG='
def blockers:
  ((.body // "") | [splits("\n")]
   | map(select(test("^[[:space:]]*blocked[[:space:]]+by\\b"; "i")))
   | join(" ")
   | [match("#[0-9]+"; "g").string | ltrimstr("#") | tonumber] | unique);
def lbl($n): (([.labels[]?.name] | index($n)) != null);
(map(select(type == "object"))) as $issues
| ($issues | map(.number)) as $open
| ($issues | map({number: .number, title: (.title // ""),
                  blocked_by: [blockers[] | select(. as $n | $open | index($n))],
                  inflight: lbl("mgr:in-flight"),
                  awaiting: lbl("mgr:awaiting-approval"),
                  plan_awaiting: lbl("mgr:awaiting-plan")})) as $I
| ([$I[] | select(.inflight)
         | (.number | tostring) as $key
         | (($launches[$key] // null) | if type == "object" then . else null end) as $stamp
         | {number: .number, title: .title,
            launched_at: (if $stamp == null then null else ($stamp.launched_at // null) end),
            launch_model: (if $stamp == null then null else ($stamp.launch_model // null) end),
            model: ($models[$key] // null)}]
   | sort_by(.number)) as $in_flight
| ([$I[] | select(.awaiting and (.inflight | not)) | {number: .number, title: .title}]
   | sort_by(.number)) as $awaiting
| ([$I[] | select(.plan_awaiting and (.inflight | not)) | {number: .number, title: .title}]
   | sort_by(.number)) as $awaiting_plan
| ([$I[] | select((.inflight | not) and (.awaiting | not) and (.plan_awaiting | not) and ((.blocked_by | length) == 0))
         | {number: .number, title: .title, blocked_by: .blocked_by}] | sort_by(.number)) as $ready
| ([$I[] | select((.inflight | not) and (.awaiting | not) and (.plan_awaiting | not) and ((.blocked_by | length) > 0))
         | {number: .number, title: .title, blocked_by: .blocked_by}] | sort_by(.number)) as $blocked
# The ledger row keeps 50 entries per list; `full` is what the timeline simulates over, so a
# repo with hundreds of queued issues still gets an ETA for every one of them.
| {ledger: {ready: ($ready | .[0:50]), blocked: ($blocked | .[0:50]),
            in_flight: $in_flight, awaiting_approval: $awaiting,
            awaiting_plan: $awaiting_plan,
            cap: $cap,
            slots_free: ([0, ($cap - ($in_flight | length) - $adopting)] | max),
            counts: {ready: ($ready | length), blocked: ($blocked | length),
                     in_flight: ($in_flight | length), awaiting_approval: ($awaiting | length),
                     awaiting_plan: ($awaiting_plan | length),
                     open: ($issues | length)}},
   full: {ready: $ready, blocked: $blocked}}'

# every throughput ledger as {"<owner>__<repo>": [duration_s, ...]} -> the stats for one repo.
# n is always the row count of this repo; the numbers fall back repo -> machine -> default.
JQ_THROUGHPUT='
def med($a): ($a | sort) as $s | ($s | length) as $n
  | if $n == 0 then null
    elif (($n % 2) == 1) then $s[(($n - 1) / 2)]
    else (($s[($n / 2) - 1] + $s[($n / 2)]) / 2) end;
def p80($a): ($a | sort) as $s | ($s | length) as $n
  | if $n == 0 then null else $s[((((0.8 * $n) | ceil) - 1))] end;
def last10($a): ($a | .[-10:]) as $s
  | if ($s | length) == 0 then null else (($s | add) / ($s | length)) end;
(($map[$slug] // [])) as $rows
| ([$map | to_entries[] | .value[]]) as $all
| ($rows | length) as $n
| (if $n >= 3 then {sample: $rows, source: "repo", estimated: false}
   elif ($all | length) > 0 then {sample: $all, source: "machine", estimated: true}
   else {sample: [], source: "default", estimated: true} end) as $pick
| if $pick.source == "default"
  then {n: $n, median_s: $default_s, p80_s: $default_s, last_10_mean_s: $default_s,
        estimated: true, source: "default"}
  else {n: $n, median_s: (med($pick.sample) | round), p80_s: (p80($pick.sample) | round),
        last_10_mean_s: (last10($pick.sample) | round),
        estimated: $pick.estimated, source: $pick.source}
  end'

# state.json + now -> the machine-wide picture. Burn gives the stall window, the backlog
# snapshots give the queues, and a FIFO simulation per manager (cap slots, blockers, the
# measured median) turns them into an ETA per issue. Projection only: nothing here acts.
JQ_OVERVIEW='
(($st.managers // {})) as $mobj
| ([$mobj | to_entries[] | .value | select(.live == true)]) as $live
| ([($st.providers // {}) | to_entries[] | .key as $p
    | ((.value.limits // [])[])
    | {id: (.id // "unknown"), provider: $p, used: (.used // 0),
       burn_per_hour: (.burn_per_hour // 0), projected_at_reset: (.projected_at_reset // 0),
       resets_at: (.resets_at // null),
       # `//` would read a real `false` as absent, and every limit that does not fit is
       # exactly the one this projection is about
       fits: (if (.fits == null) then true else .fits end),
       status: (.status // "unknown")}]) as $l0
| ([$l0[] | . + {exhaust_at:
     (if ((.status == "exhausted") or (.used >= 1)) then $now
      elif ((.fits | not) and (.burn_per_hour > 0))
      then (((($now + ((1 - .used) / .burn_per_hour * 3600000)) | round) as $e
             | if .resets_at == null then $e else ([$e, .resets_at] | min) end))
      else null end)}]) as $limits
| ([$limits[] | select((.exhaust_at != null) and (.resets_at != null) and (.resets_at > $now))]) as $sampled
# a held verdict carries no limits on purpose, but the provider it names is still dead until
# its reset: with no window of its own the manager on it would project straight through a
# stall this same state calls exhausted. Synthesise one from the verdict — burn.limits is
# untouched, so the board still renders no quota reading yet. Sampled rows stay first, so a
# real limit wins any tie for the same provider.
| ([($st.providers // {}) | to_entries[]
    | select((.value.status == "exhausted") and ((.value.recovers_at // null) != null)
             and ($now < .value.recovers_at))
    | {id: (.value.exhausted_limit // null), provider: .key,
       exhaust_at: $now, resets_at: .value.recovers_at}]) as $held
| (($sampled + $held)) as $stalling
| ($stalling | sort_by(.exhaust_at) | first) as $worst
| (if $worst == null then null
   else {from: $worst.exhaust_at, to: $worst.resets_at, limit: $worst.id} end) as $win
# the machine-wide window above stays the record. A manager can only ever be stalled by its
# own subscription, so every provider also gets its own earliest-exhausting window and sim()
# hands each manager that one: a foreign reset must not bend the ETAs a caller reads as its.
| (($stalling | group_by(.provider)
    | map((sort_by(.exhaust_at) | first) as $w
          | {key: $w.provider, value: {from: $w.exhaust_at, to: $w.resets_at, limit: $w.id}})
    | from_entries)) as $wins
| ({n: 0, median_s: $default_s, p80_s: $default_s, last_10_mean_s: $default_s,
    estimated: true, source: "default"}) as $tdef

# wall time minus the stall: work that would have run inside the window lands after it.
# $w is the window of whoever is being simulated, never the machine-wide one
| def finish($start; $work; $w):
    (if $w == null then ($start + $work)
     elif (($start >= $w.from) and ($start < $w.to)) then ($w.to + $work)
     elif (($start < $w.from) and (($start + $work) > $w.from))
     then ($w.to + ($start + $work - $w.from))
     else ($start + $work) end) | round;

# one manager: in-flight ETAs first, then FIFO passes over ready+blocked. A pass schedules
# every issue whose blockers are known (or absent from this repo) onto the earliest free
# slot; passes repeat until one schedules nothing, and the leftovers keep a null eta.
def sim($m):
    (($m.backlog // null)) as $snap
    | (($snap // {})) as $b
    # before the first refresh (or under a guard that predates it) the registration stands in
    # for the counts — the cap is what the operator set, in_flight/ready are what the manager
    # last reported — and the verdicts that need the queue (idle, starving, drains) stay null
    | (($b.cap // $m.cap // 0)) as $cap
    | (($m.throughput // $tdef)) as $t
    | ((($t.median_s // $default_s) * 1000)) as $med
    | (if (($t.estimated) == null) then true else $t.estimated end) as $est
    | (($m.repo // null)) as $repo
    | (($m.manager_id // "")) as $mid
    # a manager that names a provider is stalled only by that subscription: its own window,
    # null when that provider has none, never a foreign reset it cannot spend against. One
    # that names none is on no subscription in particular, so it keeps the machine-wide
    # window — the same fallback the text quota line makes for an unresolvable caller.
    # The type test is load-bearing: a state written before register validated the key can
    # carry a number or an array here, and indexing $wins with one aborts the whole program
    | (if (($m.provider | type) != "string") or ($m.provider == "") then $win
       else ($wins[$m.provider] // null) end) as $mwin
    # what the builder runs on travels with the item: the current model, the model it was
    # launched on (verbatim, as the stamp has it) and, when the harness moved it off that
    # model, `"<launch short>→<current>"` — the one string a render needs to say so. Both
    # sides have to be known: a builder with no session line yet, and an adopted one with
    # no launch stamp, are unknowns, never a change.
    | ([($b.in_flight // [])[]
        | (.launched_at // null) as $la
        | (.model // null) as $cm
        | (.launch_model // null) as $lm
        | ($lm | short_model) as $lms
        | (if $la == null then ($now + $med)
           else ($la + ([$med, (($now - $la) + (0.25 * $med))] | max)) end) as $raw
        | {repo: $repo, number: .number, title: (.title // ""), state: "in_flight",
           eta: finish($now; $raw - $now; $mwin), estimated: ($est or ($la == null)),
           model: $cm, launch_model: $lm,
           model_changed: (if ($cm == null) or ($lms == null) or ($lms == $cm) then null
                           else ($lms + "→" + $cm) end),
           blocked_by: [], manager_id: $mid}]) as $inflight
    # the ledger lists stop at 50; the tick also files the whole queue under backlog/, and
    # the simulation runs on everything — only the display is capped
    | (($full[(($repo // "") | split("/") | join("__"))] // null)) as $fq
    | (if $fq == null then $b else $fq end) as $qsrc
    | (([($qsrc.ready // [])[] | {repo: $repo, number: .number, title: (.title // ""),
                                  state: "ready", blocked_by: (.blocked_by // []), manager_id: $mid}]
        + [($qsrc.blocked // [])[] | {repo: $repo, number: .number, title: (.title // ""),
                                      state: "blocked", blocked_by: (.blocked_by // []), manager_id: $mid}])
       | sort_by(.number)) as $queue
    | ([$inflight[] | .number]) as $infn
    | ([$queue[] | .number]) as $qn
    | ([$inflight[] | .eta] | sort) as $ietas
    | ($inflight | length) as $n
    | (if $cap <= 0 then []
       elif $n >= $cap then $ietas[($n - $cap):]
       else ($ietas + [range(0; $cap - $n) | $now]) end) as $slots0
    | ({slots: $slots0,
        done: ([$inflight[] | {key: (.number | tostring), value: .eta}] | from_entries),
        sched: [], pending: $queue, moved: true}
       | until(((.moved | not) or ((.pending | length) == 0));
           reduce .pending[] as $it
             ({slots: .slots, done: .done, sched: .sched, pending: [], moved: false};
              . as $acc
              # `. as $bn` first: inside `index(...)` the dot is the array being searched,
              # so a bare `index(.)` would report every blocker as present (bin/mgr does the
              # same dance). A blocker this manager does not own counts as already passed.
              | ([($it.blocked_by // [])[] | . as $bn
                  | select((($qn | index($bn)) != null) or (($infn | index($bn)) != null))]) as $rel
              | ([$rel[] | select(((($acc.done[(. | tostring)]) // null) == null))] | length) as $unknown
              | if (($unknown > 0) or (($acc.slots | length) == 0))
                then ($acc | .pending += [$it])
                else ((($acc.slots | sort)) as $ss
                      | ([$ss[0]] + [$rel[] | $acc.done[(. | tostring)]] | max) as $start
                      | finish($start; $med; $mwin) as $eta
                      | $acc | .slots = ([$eta] + $ss[1:])
                             | .done += {($it.number | tostring): $eta}
                             | .sched += [$it + {eta: $eta, estimated: $est}]
                             | .moved = true)
                end))) as $r
    | (($r.sched + [$r.pending[] | . + {eta: null, estimated: $est}])) as $qout
    | (($b.counts // {ready: ($m.ready // 0), in_flight: ($m.in_flight // 0)})) as $c
    | (($c.ready // 0)) as $nready
    | (if ($snap != null) and ($nready == 0) then ($b.slots_free // 0) else 0 end) as $idle
    | {row: {manager_id: $mid, repo: $repo, provider: ($m.provider // null),
             # the window this manager can actually be stalled by, for a render that names a
             # limit as the callers own; burn.stall_window stays the machine-wide record
             stall_window: $mwin, cap: $cap, ready: $nready,
             blocked: ($c.blocked // 0), in_flight: ($c.in_flight // 0),
             awaiting_approval: ($c.awaiting_approval // 0),
             awaiting_plan: ($c.awaiting_plan // 0),
             idle_slots: $idle, starving: ($idle > 0),
             starves_at: (if ($snap == null) or ($cap <= 0) then null
                          elif $idle > 0 then $now
                          else ($r.slots | min) end),
             backlog_drains_at: ([$qout[] | .eta | select(. != null)] | max),
             throughput: $t, backlog_at: ($m.backlog_at // null),
             backlog_error: ($m.backlog_error // null)},
       open: ($c.open // 0), inflight: $inflight, queued: $qout};

  ([$live[] | sim(.)]) as $sims
| ([$sims[] | .row] | sort_by([(.repo // ""), .manager_id])) as $mrows
| ([$sims[] | .inflight[]]
   | sort_by([(if .eta == null then 1 else 0 end), (.eta // 0), (.repo // ""), .number])) as $inf
| ([$sims[] | .queued[]]
   | sort_by([(if .eta == null then 1 else 0 end), (.eta // 0), (.repo // ""), .number])) as $q
| ([$mrows[] | .backlog_drains_at | select(. != null)] | max) as $drains
| ($q[$limit:]) as $hidden
| {at: $now,
   burn: {limits: $limits, stall_window: $win},
   backlog: {totals: {ready: ([$mrows[] | .ready] | add // 0),
                      blocked: ([$mrows[] | .blocked] | add // 0),
                      in_flight: ([$mrows[] | .in_flight] | add // 0),
                      awaiting_approval: ([$mrows[] | .awaiting_approval] | add // 0),
                      awaiting_plan: ([$mrows[] | .awaiting_plan] | add // 0),
                      cap: ([$mrows[] | .cap] | add // 0),
                      idle_slots: ([$mrows[] | .idle_slots] | add // 0),
                      open: ([$sims[] | .open] | add // 0)},
             managers: $mrows},
   timeline: {shown: ($inf + $q[0:$limit]),
              beyond: (if ($hidden | length) == 0 then null
                       else {count: ($hidden | length),
                             blocked: ([$hidden[] | select(.state == "blocked")] | length),
                             last_eta: ([$hidden[] | .eta | select(. != null)] | max),
                             drains_at: $drains} end),
              drains_at: $drains, last_eta: $drains}}'

# ---------------------------------------------------------------- inputs

read_state() {
  if [ -f "$STATEFILE" ]; then jq -c . "$STATEFILE" 2>/dev/null || printf '{}'
  else printf '{}'; fi
}

# machine-wide default provider (omp config's modelRoles.default prefix). Retained for
# exactly two roles now that the poll set follows live managers' own providers: the
# fallback poll target when no live manager and no stalled pane names a provider, and the
# value of state.builder_provider (informational only — it no longer decides what gets polled).
builder_provider() {
  local d=""
  if command -v omp >/dev/null 2>&1; then
    d=$(omp config list --json 2>/dev/null | jq -r '.modelRoles.value.default // ""' 2>/dev/null) || d=""
  fi
  d="${d%%/*}"
  case "$d" in ''|null) d="anthropic";; esac
  printf '%s' "$d"
}

agents_json() { # every agent herdr knows about, or [] when herdr is unusable
  local a=""
  if command -v herdr >/dev/null 2>&1; then
    a=$(herdr agent list 2>/dev/null | jq -c '.result.agents // []' 2>/dev/null) || a=""
  fi
  case "$a" in ''|null) a='[]';; esac
  printf '%s' "$a"
}

managers_json() { # the registrations, never the board's last_report files next to them
  local out="" f j
  for f in "$MGRDIR"/*.json; do
    [ -f "$f" ] || continue
    case "$f" in *.last_report.json) continue;; esac
    j=$(jq -c 'select(type == "object" and (.manager_id | type) == "string")' "$f" 2>/dev/null) || continue
    [ -n "$j" ] || continue
    out+="$j"$'\n'
  done
  printf '%s' "$out" | jq -sc .
}

# ---- the collector. `mgr` writes launches/<owner>__<repo>.json and throughput/<owner>__<repo>.jsonl;
# the guard only ever reads those, asks gh for the board data itself so the overview stays
# fresh machine-wide even when a manager has not run `mgr board` in a while, and files the
# whole queue of each repo under backlog/<owner>__<repo>.json for the timeline to simulate on.

repo_slug() { printf '%s' "${1//\//__}"; }

launches_json() { # launches_json <repo> -> {"<number>": {number,launched_at}}
  local f j
  [ -n "${1:-}" ] || { printf '{}'; return; }
  f="$LAUNCHDIR/$(repo_slug "$1").json"
  if [ ! -f "$f" ]; then printf '{}'; return; fi
  j=$(jq -c 'select(type == "object")' "$f" 2>/dev/null) || j=""
  case "$j" in ''|null) j='{}';; esac
  printf '%s' "$j"
}

throughput_map() { # every ledger as {"<owner>__<repo>": [duration_s, ...]}, rows in file order
  local map='{}' f slug arr
  for f in "$THRUDIR"/*.jsonl; do
    [ -f "$f" ] || continue
    slug=$(basename "$f" .jsonl)
    arr=$(jq -Rnc '[inputs | (fromjson? // empty) | select(type == "object")
                    | .duration_s | select(type == "number") | select(. >= 0)]' "$f" 2>/dev/null) || arr='[]'
    case "$arr" in ''|null) arr='[]';; esac
    map=$(jq -c --arg s "$slug" --argjson a "$arr" '. + {($s): $a}' <<<"$map")
  done
  printf '%s' "$map"
}

backlog_map() { # every filed queue as {"<owner>__<repo>": {at, repo, ready, blocked}}
  local map='{}' f slug obj
  for f in "$BACKLOGDIR"/*.json; do
    [ -f "$f" ] || continue
    slug=$(basename "$f" .json)
    obj=$(jq -c 'select(type == "object")
                 | {at: (.at // null), repo: (.repo // null),
                    ready: (if (.ready | type) == "array" then .ready else [] end),
                    blocked: (if (.blocked | type) == "array" then .blocked else [] end)}' \
          "$f" 2>/dev/null) || obj=""
    case "$obj" in ''|null) continue;; esac
    map=$(jq -c --arg s "$slug" --argjson o "$obj" '. + {($s): $o}' <<<"$map")
  done
  printf '%s' "$map"
}

gh_issues() { # gh_issues <repo> <cache-dir> -> open issues JSON, non-zero when gh cannot answer
  local repo="$1" dir="$2" cache out=""
  cache="$dir/$(repo_slug "$repo")"
  if [ -f "$cache.json" ]; then cat "$cache.json"; return 0; fi
  if [ -f "$cache.err" ]; then return 1; fi
  if command -v gh >/dev/null 2>&1; then
    out=$(gh issue list -R "$repo" --state open --limit 200 \
            --json number,title,labels,body 2>/dev/null) || out=""
  fi
  if [ -n "$out" ]; then
    out=$(jq -c 'select(type == "array")' <<<"$out" 2>/dev/null) || out=""
  fi
  if [ -z "$out" ]; then : >"$cache.err"; return 1; fi
  printf '%s' "$out" >"$cache.json"
  printf '%s' "$out"
}

# collect_extras <managers-json> <prev-state> <now> <agent-facts>
#   -> {"<manager_id>": {backlog, backlog_at, backlog_error, throughput}}
# One gh call per distinct repo per tick, and only for managers whose snapshot is older than
# MGR_GUARD_BACKLOG_INTERVAL_S. A refresh that fails keeps the previous snapshot and says so;
# throughput is a file read, so it is recomputed every tick. Every successful refresh also
# files the uncapped queue under backlog/, which is what `overview` simulates over.
# The agent facts are the tick's own scan: the model each `issue-<N>` builder pane is on
# right now, scoped to the manager's workspace the way bin/mgr's ws_agents scopes it — an
# `issue-10` in another workspace is another manager's builder, never this one's.
collect_extras() {
  local managers="$1" prev="$2" now="$3" agents="${4:-[]}"
  local extras='{}' cache tmap m mid repo ws models cap adopting prevrow prev_at due issues raw bl thr err row
  cache=$(mktemp -d "${TMPDIR:-/tmp}/mgr-guard-backlog.XXXXXX" 2>/dev/null) || cache=""
  tmap=$(throughput_map)
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    mid=$(jq -r '.manager_id // ""' <<<"$m")
    [ -n "$mid" ] || continue
    repo=$(jq -r '.repo // ""' <<<"$m")
    ws=$(jq -r '.workspace_id // ""' <<<"$m")
    # the model per in-flight issue number, for JQ_BACKLOG to join onto its in_flight list.
    # A scan that cannot be read degrades to no reading at all, never to a failed refresh
    models=$(jq -c --arg ws "$ws" \
      '[ .[] | select((.workspace_id // "") == $ws)
             | select(((.name // "") | test("^issue-[0-9]+$")))
             | {key: ((.name // "") | ltrimstr("issue-")), value: (.model // null)} ]
       | from_entries' <<<"$agents" 2>/dev/null) || models=""
    case "$models" in ''|null) models='{}';; esac
    cap=$(jq -r '((.cap // 0) | floor)' <<<"$m")
    adopting=$(jq -r '((.adopting // 0) | floor)' <<<"$m")
    prevrow=$(jq -c --arg id "$mid" '((.managers // {})[$id] // {})
      | {backlog: (.backlog // null), backlog_at: (.backlog_at // null),
         backlog_error: (.backlog_error // null)}' <<<"$prev")
    prev_at=$(jq -r '((.backlog_at // "") | tostring)' <<<"$prevrow")
    due=1
    case "$prev_at" in
      ''|*[!0-9]*) due=1;;
      *) if [ $(( now - prev_at )) -lt $(( BACKLOG_INTERVAL_S * 1000 )) ]; then due=0; fi;;
    esac
    thr=$(jq -nc --argjson map "$tmap" --arg slug "$(repo_slug "$repo")" \
      --argjson default_s "$DEFAULT_TASK_S" "$JQ_THROUGHPUT")
    raw=""; bl=""; err=""
    if [ "$due" = 1 ]; then
      if [ -z "$repo" ]; then
        err="no repo on the registration"
      elif [ -z "$cache" ]; then
        err="cannot create a tick cache dir"
      elif issues=$(gh_issues "$repo" "$cache"); then
        raw=$(jq -c --argjson launches "$(launches_json "$repo")" --argjson cap "$cap" \
          --argjson adopting "$adopting" --argjson models "$models" \
          "$JQ_BACKLOG" <<<"$issues" 2>/dev/null) || raw=""
        if [ -n "$raw" ]; then
          bl=$(jq -c '.ledger' <<<"$raw")
          mkdir -p "$BACKLOGDIR" 2>/dev/null || true
          jq -c --arg repo "$repo" --argjson at "$now" \
            '{at: $at, repo: $repo, ready: .full.ready, blocked: .full.blocked}' <<<"$raw" \
            | atomic_write "$BACKLOGDIR/$(repo_slug "$repo").json" \
            || warn "cannot write $BACKLOGDIR/$(repo_slug "$repo").json"
        else
          err="backlog projection failed"
        fi
      else
        err="gh issue list failed"
      fi
      [ -z "$err" ] || log warn "backlog refresh for $mid ($repo): $err"
    fi
    if [ -n "$bl" ]; then
      row=$(jq -nc --argjson b "$bl" --argjson at "$now" --argjson t "$thr" \
        '{backlog: $b, backlog_at: $at, backlog_error: null, throughput: $t}')
    else
      row=$(jq -nc --argjson p "$prevrow" --argjson t "$thr" --arg e "$err" \
        '{backlog: $p.backlog, backlog_at: $p.backlog_at,
          backlog_error: (if $e == "" then $p.backlog_error else $e end), throughput: $t}')
    fi
    extras=$(jq -c --arg id "$mid" --argjson v "$row" '. + {($id): $v}' <<<"$extras")
  done < <(jq -c '.[]' <<<"$managers")
  [ -z "$cache" ] || rm -rf "$cache"
  printf '%s' "$extras"
}

session_facts() { # session_facts <file> <now> -> {provider,model,stall}
  local f="${1:-}" now="$2" size body
  if [ -z "$f" ] || [ ! -f "$f" ]; then
    jq -nc '{provider:null,model:null,stall:null}'; return
  fi
  size=$(wc -c <"$f" 2>/dev/null | tr -d ' ') || size=0
  case "$size" in ''|*[!0-9]*) size=0;; esac
  if [ "$size" -gt 65536 ]; then
    body=$(tail -c 65536 "$f" 2>/dev/null | sed 1d) || body=""
  else
    body=$(cat "$f" 2>/dev/null) || body=""
  fi
  printf '%s\n' "$body" \
    | jq -Rnc --arg re "$RATE_RE" --argjson now "$now" "$JQ_SESSION_FACTS" \
    || jq -nc '{provider:null,model:null,stall:null}'
}

scan_agents() { # scan_agents <agents-json> <now> -> array of agent facts
  local agents="$1" now="$2" a session facts out=""
  while IFS= read -r a; do
    [ -n "$a" ] || continue
    session=$(jq -r '.agent_session.value // ""' <<<"$a")
    facts=$(session_facts "$session" "$now")
    out+=$(jq -c --argjson f "$facts" \
      '{name:(.name // null), pane_id, tab_id:(.tab_id // null),
        workspace_id:(.workspace_id // null), agent_status:(.agent_status // "unknown"),
        session:(.agent_session.value // null),
        provider:$f.provider, model:$f.model, stall:$f.stall}' <<<"$a")
    out+=$'\n'
  done < <(jq -c '.[] | select((.agent // "omp") == "omp")
                       | select(((.name // "") | test("^(issue-|adopt-|manager)")))' <<<"$agents")
  printf '%s' "$out" | jq -sc .
}

fetch_provider() { # fetch_provider <provider> <prev-state> -> normalized report
  # One retry inside the tick before degrading: `omp usage` failing once is a hiccup, and
  # degrading to unknown on a hiccup is what makes the guard forget an exhausted window.
  local p="$1" prev="$2" u="" rep="" try
  for try in 1 2; do
    u=""
    if command -v omp >/dev/null 2>&1; then
      omp usage invalidate --provider "$p" >/dev/null 2>&1 || true
      u=$(omp usage --json --provider "$p" 2>/dev/null) || u=""
    fi
    if [ -n "$u" ]; then
      rep=$(jq -c --arg p "$p" '[.reports[]? | select(.provider == $p)] | first // empty' <<<"$u" 2>/dev/null) || rep=""
    fi
    [ -z "$rep" ] || break
    [ "$try" = 2 ] || log warn "usage fetch for $p came back empty, retrying once"
  done
  if [ -n "$rep" ]; then
    jq -c --arg p "$p" --argjson prev "$prev" \
      '(($prev.providers // {})[$p] // {}) as $pp
       | {provider:$p, ok:true, fetched_at:(.fetchedAt // null),
          prev_failures:($pp.usage_fetch_failures // 0),
          prev_recovers_at:($pp.recovers_at // null),
          prev_exhausted_limit:($pp.exhausted_limit // null),
          limits:[.limits[]? | {id:(.id // "unknown"), label:(.label // .id // "unknown"),
                                status:(.status // "unknown"),
                                used:(.amount.usedFraction // 0),
                                resets_at:(.window.resetsAt // null)}]}' <<<"$rep"
  else
    # the previous reading travels with the failure so the policy can hold the last verdict
    jq -nc --arg p "$p" --argjson prev "$prev" \
      '(($prev.providers // {})[$p] // {}) as $pp
       | {provider:$p, ok:false, fetched_at:($pp.fetched_at // null),
          prev_failures:($pp.usage_fetch_failures // 0),
          prev_recovers_at:($pp.recovers_at // null),
          prev_exhausted_limit:($pp.exhausted_limit // null),
          limits:[($pp.limits // [])[] | {id, label, status, used, resets_at}]}'
  fi
}

prune_samples() { # prune_samples <cutoff-ms> -> samples array (and rewrites the file)
  local keep
  [ -f "$SAMPLES" ] || { printf '[]'; return; }
  keep=$(jq -Rnc --argjson cut "$1" \
    '[inputs | (fromjson? // empty) | select(type == "object" and ((.t // 0) >= $cut))]' \
    "$SAMPLES" 2>/dev/null) || keep='[]'
  jq -c '.[]' <<<"$keep" 2>/dev/null | atomic_write "$SAMPLES" || true
  printf '%s' "$keep"
}

notify() { # notify <body>
  [ "$NOTIFY" != 0 ] || return 0
  command -v herdr >/dev/null 2>&1 || return 0
  herdr notification show "mgr-guard" --body "$1" --sound none >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------- stall

cmd_stall() {
  local f=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift;;
      -*) die 2 "usage: mgr-guard stall <session.jsonl>";;
      *) f="$1"; shift;;
    esac
  done
  [ -n "$f" ] || die 2 "usage: mgr-guard stall <session.jsonl>"
  [ -e "$f" ] || die 4 "session file not found: $f"
  session_facts "$f" "$(now_ms)" | jq -c '.stall'
}

# ---------------------------------------------------------------- register

cmd_register() {
  local input="${1:-}"
  [ -n "$input" ] || die 2 "usage: mgr-guard register '<json>'"
  ensure_state_dir
  local obj missing badnum badid mid now out
  obj=$(jq -c 'select(type == "object")' <<<"$input" 2>/dev/null) || die 2 "register: argument is not valid JSON"
  [ -n "$obj" ] || die 2 "register: argument must be a JSON object"
  missing=$(jq -nr --argjson o "$obj" \
    '["manager_id","workspace_id","pane_id","repo","primary","cap","in_flight","adopting","ready"]
     | map(select($o[.] == null)) | join(",")')
  [ -z "$missing" ] || die 2 "register: missing keys: $missing"
  badnum=$(jq -nr --argjson o "$obj" \
    '["cap","in_flight","adopting","ready"] | map(select(($o[.] | type) != "number")) | join(",")')
  [ -z "$badnum" ] || die 2 "register: not numbers: $badnum"
  # house/provider come from the callers house resolution and stay optional: an older `mgr`
  # sends neither key, and the current one sends provider: null when the house cannot be
  # resolved. A value that is there is an id though, and the projection indexes providers by
  # it — a number or an array here used to abort `overview` for every manager on the machine
  badid=$(jq -nr --argjson o "$obj" \
    '["house","provider"]
     | map(select((($o[.] | type) != "null")
                  and (if ($o[.] | type) != "string" then true
                       else ($o[.] | test("^[A-Za-z0-9._:-]+$") | not) end)))
     | join(",")')
  [ -z "$badid" ] || die 2 "register: must match [A-Za-z0-9._:-]+ : $badid"
  mid=$(jq -r '.manager_id' <<<"$obj")
  case "$mid" in
    ''|*[!A-Za-z0-9_.:-]*) die 2 "register: manager_id must match [A-Za-z0-9_.:-]+ : $mid";;
  esac
  now=$(now_ms)
  out=$(jq -c --argjson now "$now" '. + {seen_at:$now}' <<<"$obj")
  printf '%s\n' "$out" | atomic_write "$MGRDIR/$mid.json" || die 1 "cannot write $MGRDIR/$mid.json"
  printf '%s\n' "$out"
}

# The cheap heartbeat: every `mgr` invocation refreshes seen_at so a manager coming back from
# a 429 stops looking silent, without paying for a whole `register` payload. The pane has to
# match the registration on disk — a stale pane id must never refresh someone else's entry,
# and a manager with no registration is simply not touched.
cmd_touch() {
  local mid="${1:-}" pane="${2:-}" f now out
  [ -n "$mid" ] && [ -n "$pane" ] || die 2 "usage: mgr-guard touch <manager_id> <pane_id>"
  case "$mid" in
    *[!A-Za-z0-9_.:-]*) die 2 "touch: manager_id must match [A-Za-z0-9_.:-]+ : $mid";;
  esac
  f="$MGRDIR/$mid.json"
  now=$(now_ms)
  if [ -f "$f" ] && [ "$(jq -r '.pane_id // ""' "$f" 2>/dev/null || printf '')" = "$pane" ]; then
    out=$(jq -c --argjson now "$now" '. + {seen_at:$now}' "$f" 2>/dev/null) || out=""
    if [ -n "$out" ]; then
      printf '%s\n' "$out" | atomic_write "$f" || die 1 "cannot write $f"
      jq -nc --arg id "$mid" --argjson now "$now" '{touched:true, manager_id:$id, seen_at:$now}'
      return 0
    fi
  fi
  jq -nc --arg id "$mid" '{touched:false, manager_id:$id}'
}

# ---------------------------------------------------------------- tick

cmd_tick() {
  ensure_state_dir
  local now prev bp agents panes facts providers p rep reports='[]' samples managers extras
  now=$(now_ms)
  prev=$(read_state)
  bp=$(builder_provider)
  agents=$(agents_json)
  panes=$(jq -c '[.[] | .pane_id // empty]' <<<"$agents")
  facts=$(scan_agents "$agents" "$now")
  managers=$(managers_json)

  # the poll set is every provider a live manager or a stalled pane actually needs sampled —
  # never a single machine-wide default; builder_provider() only fills in when that is empty.
  # The charset gate covers every branch, the fallback included: whatever a manager filed, a
  # session line reported or omp config named, only an id ever reaches `omp usage`
  providers=$(jq -r --arg bp "$bp" --argjson managers "$managers" --argjson panes "$panes" \
    'def usable: select(type == "string" and test("^[A-Za-z0-9._:-]+$"));
     (([$managers[] | select((.pane_id // "") | IN($panes[])) | .provider]
        + [.[] | select(.stall != null) | (.stall.provider // empty)])
      | map(usable) | unique) as $set
     | (if ($set | length) == 0 then ([$bp] | map(usable)) else $set end)
     | .[]' <<<"$facts")

  # the gate above is the only door, so nothing carrying a glob character or a newline can
  # reach here: read it a line at a time all the same, never as an unquoted word list
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    rep=$(fetch_provider "$p" "$prev")
    reports=$(jq -c --argjson r "$rep" '. + [$r]' <<<"$reports")
    if [ "$(jq -r '.ok' <<<"$rep")" = true ]; then
      jq -c --argjson now "$now" \
        '. as $r | $r.limits[] | {t:$now, provider:$r.provider, limit:.id,
                                  used:.used, resets_at:.resets_at, status:.status}' <<<"$rep" \
        >>"$SAMPLES" 2>/dev/null || warn "cannot append to $SAMPLES"
    else
      log warn "usage fetch failed for $p (degraded to unknown)"
    fi
  done < <(printf '%s\n' "$providers")

  samples=$(prune_samples "$(( now - 86400000 ))")

  # the backlog snapshot and throughput stats ride along on the manager rows, and the pane
  # scan the tick already did says which model each builder is on right now
  extras=$(collect_extras "$managers" "$prev" "$now" "$facts")

  local policy
  policy=$(jq -nc \
    --argjson now "$now" --arg bp "$bp" \
    --argjson agents "$facts" --argjson panes "$panes" \
    --argjson managers "$managers" --argjson prev "$prev" \
    --argjson reports "$reports" --argjson samples "$samples" \
    --argjson slope_window "$SLOPE_WINDOW_S" --argjson min_span "$MIN_SLOPE_SPAN_S" \
    --argjson extras "$extras" \
    "$JQ_POLICY") || die 1 "policy evaluation failed"

  # dead registrations go away, and so does the board report filed next to them
  local id
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    case "$id" in ''|*[!A-Za-z0-9_.:-]*) continue;; esac
    rm -f "$MGRDIR/$id.json"
    rm -f "$MGRDIR/$id.last_report.json"
    log info "manager_dropped $id"
  done < <(jq -r '.dead[]? // empty' <<<"$policy")

  # reignition
  local results='[]' c pane text ok
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    pane=$(jq -r '.pane_id' <<<"$c")
    text=$(jq -r '.text' <<<"$c")
    ok=false
    # This is the one mgr-side path that can `herdr agent prompt` a pane that might be
    # holding the model-fallback reserve dialog: it only fires for a pane with a recorded
    # rate-limit stall, so it needs a 429 → reignite → dialog race, and under the default
    # `never` policy that dialog cannot appear at all.
    if command -v herdr >/dev/null 2>&1 && herdr agent prompt "$pane" "$text" >/dev/null 2>&1; then
      ok=true
      log info "reignite $pane ok"
    else
      log error "reignite $pane failed (herdr agent prompt)"
    fi
    results=$(jq -c --argjson c "$c" --argjson ok "$ok" '. + [$c + {ok:$ok}]' <<<"$results")
  done < <(jq -c '.reignite[]? // empty' <<<"$policy")

  local final pid
  pid=$(live_pid); [ -n "$pid" ] || pid=null
  final=$(jq -nc --argjson policy "$policy" --argjson results "$results" \
    --argjson prev "$prev" --argjson interval "$INTERVAL_S" --argjson pid "$pid" \
    "$JQ_FINALIZE") || die 1 "state assembly failed"

  local state
  state=$(jq -c '.state' <<<"$final")
  printf '%s\n' "$state" | atomic_write "$STATEFILE" || die 1 "cannot write $STATEFILE"

  log info "$(jq -r '.log' <<<"$final")"
  local t
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    notify "$t"
  done < <(jq -r '.toasts[]? // empty' <<<"$final")

  printf '%s\n' "$state"
}

# ---------------------------------------------------------------- run / start / stop

guard_exit() {
  rm -f "$PIDFILE"
  record_exit "stopped (signal)"
  log info "stopped (signal)"
  exit 0
}

cmd_run() {
  ensure_state_dir
  printf '%s\n' "$$" | atomic_write "$PIDFILE" || die 1 "cannot write $PIDFILE"
  trap guard_exit TERM INT
  log info "started pid=$$ interval=${INTERVAL_S}s state_dir=$STATE_DIR"
  local last_live nlive nstalled nowsec reason
  last_live=$(( $(now_ms) / 1000 ))
  while :; do
    # subshell: a `die` inside the tick must not take the daemon down with it
    ( cmd_tick ) >/dev/null 2>>"$LOGFILE" || log error "tick failed"
    # Two independent reasons to stay: a manager pane still exists, or the ledger still holds
    # a 429 nobody else will ever reignite. The stall this guard exists to recover from is
    # what kills the heartbeats, so leaving on a quiet heartbeat is exactly the wrong moment.
    nlive=$(jq -r '[.managers[]? | select(.live)] | length' "$STATEFILE" 2>/dev/null || printf '0')
    case "$nlive" in ''|*[!0-9]*) nlive=0;; esac
    nstalled=$(jq -r '(.stalled // []) | length' "$STATEFILE" 2>/dev/null || printf '0')
    case "$nstalled" in ''|*[!0-9]*) nstalled=0;; esac
    nowsec=$(( $(now_ms) / 1000 ))
    if [ "$nlive" -gt 0 ] || [ "$nstalled" -gt 0 ]; then
      last_live=$nowsec
    elif [ $(( nowsec - last_live )) -ge "$IDLE_EXIT_S" ]; then
      reason="idle-exit after ${IDLE_EXIT_S}s with no live manager and no stalled builder"
      log info "$reason"
      record_exit "$reason"
      rm -f "$PIDFILE"
      exit 0
    fi
    sleep "$INTERVAL_S" &
    wait $! || true
  done
}

cmd_start() {
  local interval=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --interval) interval="${2:-}"; shift 2;;
      *) die 2 "usage: mgr-guard start [--interval S]";;
    esac
  done
  if [ -n "$interval" ]; then
    case "$interval" in ''|*[!0-9]*) die 2 "interval must be a positive integer: $interval";; esac
    [ "$interval" -gt 0 ] || die 2 "interval must be a positive integer: $interval"
    INTERVAL_S="$interval"
  fi
  ensure_state_dir

  local pid
  pid=$(live_pid)
  if [ -n "$pid" ]; then
    jq -nc --argjson pid "$pid" --arg dir "$STATE_DIR" \
      '{running:true, pid:$pid, started:false, state_dir:$dir}'
    return 0
  fi

  if ! mkdir "$LOCKDIR" 2>/dev/null; then
    # a stale lock (no live pid, older than 60 s) is ours to clear
    local age=0 mt
    mt=$(mtime_of "$LOCKDIR")
    age=$(( $(date +%s) - ${mt:-0} ))
    if [ "$age" -ge 60 ]; then
      rmdir "$LOCKDIR" 2>/dev/null || true
      mkdir "$LOCKDIR" 2>/dev/null || die 3 "another mgr-guard start is in progress ($LOCKDIR)"
    else
      die 3 "another mgr-guard start is in progress ($LOCKDIR)"
    fi
  fi

  local newpid=""
  MGR_GUARD_INTERVAL="$INTERVAL_S" nohup "$SELF" run >>"$LOGFILE" 2>&1 &
  newpid=$!
  disown 2>/dev/null || true
  printf '%s\n' "$newpid" | atomic_write "$PIDFILE" || warn "cannot write $PIDFILE"
  rmdir "$LOCKDIR" 2>/dev/null || true

  sleep 0.3
  local running=false
  kill -0 "$newpid" 2>/dev/null && running=true
  jq -nc --argjson pid "$newpid" --argjson running "$running" --arg dir "$STATE_DIR" \
    '{running:$running, pid:$pid, started:true, state_dir:$dir}'
}

cmd_stop() {
  local pid
  pid=$(live_pid)
  if [ -z "$pid" ]; then
    rm -f "$PIDFILE"
    jq -nc '{stopped:false, pid:null}'
    return 0
  fi
  kill -TERM "$pid" 2>/dev/null || true
  for _ in $(seq 1 50); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL "$pid" 2>/dev/null || true
    sleep 0.2
  fi
  rm -f "$PIDFILE"
  local stopped=true
  kill -0 "$pid" 2>/dev/null && stopped=false
  # the daemon's own signal handler already noted the exit; an operator stop is the better
  # reason, so it overwrites that note once the process is really gone
  if [ "$stopped" = true ]; then record_exit "stopped by mgr-guard stop"; fi
  log info "stopped pid=$pid"
  jq -nc --argjson pid "$pid" --argjson stopped "$stopped" '{stopped:$stopped, pid:$pid}'
}

cmd_status() {
  local st pid guard="stopped" iv now tick ex
  st=$(read_state)
  pid=$(pidfile_pid)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    iv=$(jq -r '.interval_s // empty' <<<"$st" 2>/dev/null || printf '')
    iv=$(int_or "$iv" "$INTERVAL_S")
    tick=$(jq -r '.tick_at // 0' <<<"$st" 2>/dev/null || printf '0')
    case "$tick" in ''|*[!0-9]*) tick=0;; esac
    now=$(now_ms)
    if [ "$tick" -gt 0 ] && [ $(( now - tick )) -le $(( iv * 5 * 1000 )) ]; then
      guard="running"
    else
      guard="stale"
    fi
  else
    pid=""
  fi
  ex=$(read_exit)
  jq -nc --argjson st "$st" --arg g "$guard" --arg pid "$pid" --argjson ex "$ex" \
    '$st + {guard:$g, pid:(if $pid == "" then null else ($pid | tonumber) end),
            last_exit_at:$ex.at, last_exit_reason:$ex.reason}'
}

# ---------------------------------------------------------------- overview

# Pure projection over state.json plus the filed queues — no daemon needed, like `status`.
# What the tick collected (burn, backlog, throughput) becomes one machine-wide picture: what
# is running, what is queued, when each finishes, and which manager runs out of work when.
cmd_overview() {
  local limit=10
  while [ $# -gt 0 ]; do
    case "$1" in
      --limit) limit="${2:-}"; shift 2;;
      --) shift;;
      *) die 2 "usage: mgr-guard overview [--limit N]";;
    esac
  done
  case "$limit" in ''|*[!0-9]*) die 2 "limit must be a non-negative integer: $limit";; esac
  local st now full
  st=$(read_state)
  now=$(now_ms)
  full=$(backlog_map)
  jq -nc --argjson st "$st" --argjson now "$now" --argjson limit "$limit" \
    --argjson full "$full" \
    --argjson default_s "$DEFAULT_TASK_S" "$JQ_SHORT_MODEL$JQ_OVERVIEW" \
    || die 1 "overview projection failed"
}

# ---------------------------------------------------------------- usage

usage() {
  cat <<'EOF'
mgr-guard — 429 stall recovery, burn projection and backlog collection for herdr-hosted
omp builders

Three jobs, nothing else: re-prompt a manager or builder pane whose turn died on a provider
rate limit once the quota renews, keep a per-limit burn projection `mgr board` surfaces, and
collect every registered manager's backlog and measured throughput so `overview` can project
the machine-wide timeline. Concurrency is the operator's `cap`, enforced by `mgr` alone.

  mgr-guard start [--interval S]      daemonize the tick loop (idempotent)
  mgr-guard stop                      SIGTERM the daemon, clear guard.pid
  mgr-guard status                    state.json + guard/pid + last exit (always exit 0)
  mgr-guard overview [--limit N]      machine-wide burn, backlog and ETA timeline (JSON,
                                      no daemon needed; N queued items shown, default 10)
  mgr-guard tick                      run one tick in the foreground, print state
  mgr-guard run                       foreground tick loop (what start daemonizes)
  mgr-guard register '<json>'         upsert managers/<manager_id>.json with seen_at
                                      (provider/house are optional; they steer the poll set)
  mgr-guard touch <manager_id> <pane_id>
                                      refresh seen_at when the pane still matches
  mgr-guard stall <session.jsonl>     stall object for one omp session, or null

Env: MGR_STATE_DIR MGR_GUARD_INTERVAL MGR_GUARD_SLOPE_WINDOW_S
     MGR_GUARD_MIN_SLOPE_SPAN_S MGR_GUARD_IDLE_EXIT_S MGR_GUARD_NOTIFY
     MGR_GUARD_BACKLOG_INTERVAL_S MGR_DEFAULT_TASK_S

MGR_GUARD_IDLE_EXIT_S: the daemon exits after this long with no live manager pane and an
empty 429 ledger. MGR_GUARD_NOTIFY=0 silences the reignite toasts.
MGR_GUARD_BACKLOG_INTERVAL_S (120): how often a manager's backlog is re-fetched from gh.
MGR_DEFAULT_TASK_S (2700): the task duration assumed when no throughput row exists anywhere.
EOF
}

# ---------------------------------------------------------------- dispatch

main() {
  [ $# -gt 0 ] || { usage; exit 0; }
  local sub="$1"; shift
  case "$sub" in
    start)          cmd_start "$@";;
    stop)           cmd_stop "$@";;
    status)         cmd_status "$@";;
    tick)           cmd_tick "$@";;
    run)            cmd_run "$@";;
    register)       cmd_register "$@";;
    touch)          cmd_touch "$@";;
    overview)       cmd_overview "$@";;
    stall)          cmd_stall "$@";;
    -h|--help|help) usage; exit 0;;
    *) die 2 "unknown subcommand: $sub (try: mgr-guard --help)";;
  esac
}

main "$@"
